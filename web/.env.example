DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/snooze_cms
PAYLOAD_SECRET=generate-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DISABLE_2FA=false

# Payments: Razorpay (Dashboard > Account & Settings > API keys). Start with TEST keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Settings > Webhooks: set the secret you choose there. Address: https://YOUR-SITE/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Shipping: Shiprocket. Create a separate API user (Settings > API > Create API User) with its own email.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The pickup address name exactly as in Shiprocket (Settings > Pickup Addresses), and its pincode.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Shiprocket > Settings > API > Webhooks: address https://YOUR-SITE/api/webhooks/shiprocket and this token.
SHIPROCKET_WEBHOOK_TOKEN=
# Set to true to let the shop pick a courier automatically (this spends your Shiprocket balance).
SHIPROCKET_AUTO_AWB=false
