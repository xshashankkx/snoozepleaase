{
  "name": "snooze-pleaase-web",
  "version": "0.1.0",
  "private": true,
  "description": "Snooze Pleaase storefront and CMS (Next.js + Payload)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-content.ts",
    "dev-owner": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev-owner.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/ui": "3.90.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.0",
    "payload-totp": "^3.0.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
